# Grupo 3: central server is 192.168.56.20; the HTTP API is published on port 80.
# On Linux deploy Nginx on 80 and run the Python app on local port 5000.
API_PORT=80
# Group 2 agents run on these three monitored VMs:
MONITORED_VM1_IP=192.168.56.11
MONITORED_VM2_IP=192.168.56.12
MONITORED_VM3_IP=192.168.56.13
CENTRAL_IP=192.168.56.20

# After 120 seconds without accepted agent data, mark OFFLINE.
OFFLINE_AFTER_SECONDS=120
AVAILABILITY_CHECK_INTERVAL=15
FLASK_DEBUG=0
# For demo, '*' enables cross-origin dashboard requests. Restrict for production.
CORS_ORIGINS=*

# DEV ONLY: without MySQL credentials, the app uses local SQLite.
# For MySQL, create the 'monitoring' database and uncomment all 4 settings.
# DB_USER=monitoring
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=monitoring
# Or use DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/monitoring

# OPTIONAL SSH: ssh_diagnostics.py is safe with HTTP agents.
# collector.py writes SSH readings: do not run together with HTTP agents for same VMs.
VM1_IP=192.168.56.11
VM2_IP=192.168.56.12
VM3_IP=192.168.56.13
VM1_NAME=srv-monitor-01
VM2_NAME=srv-monitor-02
VM3_NAME=srv-monitor-03
# SSH_USER=monitor
# SSH_KEY_PATH=/home/user/.ssh/id_ed25519
# SSH_KNOWN_HOSTS=/home/user/.ssh/known_hosts
# COLLECTION_INTERVAL=60
